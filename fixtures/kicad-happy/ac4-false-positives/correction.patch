+                          if f['severity'] == 'error'], [['U5']])
+
+    def test_control_gate_divider_to_source_keeps_the_error(self):
+        # agent-469 adversarial control (1): 100 ohm to the source rail
+        # against 1 Mohm to ground holds VGS near zero.
