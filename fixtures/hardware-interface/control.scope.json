          "locator": "Structural interface"
        },
        "checks": [
          "netlist",
          "interface"
        ],
        "intent": "acceptance"
      },
      {
        "id": "response",
        "statement": "Loaded step at 1 ms is 0.62..0.65 V.",
        "source": {
          "path": "requirements.md",
          "locator": "Functional response"
        },
        "checks": [
          "response"
        ],
        "intent": "acceptance"
      }
    ],
    "targets": [
      "requirements.md"
    ],
    "reference_architectures": [
      "requirements.md"
