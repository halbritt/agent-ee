        "mm",
        "-o",
        "/work/experiments/erc.json",
        "/candidate/project/rc_filter.kicad_sch"
      ],
      "cwd": "/work/experiments",
      "exit_code": 0,
      "stdout": "erc.stdout",
      "stderr": "erc.stderr"
    },
    {
      "name": "drc",
      "argv": [
        "kicad-cli",
        "pcb",
        "drc",
        "--format",
        "json",
        "--severity-all",
