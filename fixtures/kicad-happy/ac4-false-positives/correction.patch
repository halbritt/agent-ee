+                         [("1", names[0], "passive", "PROT_NODE"),
+                          ("2", names[1], "passive", "GATE_NODE")])
+                parts = self.protection([res("R1", "100k", "GATE_NODE", "GND"), diode])
+                self.assertEqual(pp001_refs(parts), ['U5'])
