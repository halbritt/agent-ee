{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport json\nout = {}\nfor name in ['erc','drc','netlist','geometry','rc-step']:\n    check = json.loads(Path('/evidence/checks/'+name+'.json').read_text())\n    execution = json.loads(Path('/evidence/work/'+name+'/execution.json').read_text())\n    out[name] = {'execution': check['execution'], 'outcome': check['outcome'], 'summary':check['summary'], 'argv': execution['argv'], 'exit_code':execution['exit_code']}\ngeo = json.loads(Path('/evidence/work/geometry/geometry.json').read_text())\nout['geometry_observations'] = {'tracks':len([t for t in geo['tracks'] if t['type']=='track']), 'widths_mm': sorted(set(t['width_mm'] for t in geo['tracks'] if t['type']=='track')), 'unconnected_items':geo['unconnected_items']}\nPath('/work/experiments/check-records.json').write_text(json.dumps(out, indent=2)+'\\\\n')\nfor p in ['python-version.console.txt','kicad-version.console.txt','ngspice-version.console.txt']:\n    print(p, Path('/work/experiments/'+p).read_text())\nprint(json.dumps(out,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
