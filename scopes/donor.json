        "symbols/power.kicad_sym",
        "footprints/Capacitor_SMD.pretty/**",
        "footprints/Capacitor_THT.pretty/**",
        "footprints/Connector_PinHeader_2.00mm.pretty/**",
        "footprints/Connector_PinHeader_2.54mm.pretty/**",
        "footprints/Diode_SMD.pretty/**",
        "footprints/Fuse.pretty/**",
        "footprints/Jumper.pretty/**",
