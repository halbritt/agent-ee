      "cwd": "/work/experiments",
      "exit_code": 0,
      "stdout": "netlist.stdout",
      "stderr": "netlist.stderr"
    },
    {
      "name": "erc",
      "argv": [
        "kicad-cli",
        "sch",
        "erc",
        "--format",
        "json",
        "--severity-all",
