+def _driven_chip_select(ctx: AnalysisContext, ref: str) -> tuple[str, str, str] | None:
+    """Return (cs_net, 'REF.PIN', REF) when ``ref``'s chip-select pin is driven.
+
+    A chip-select pin on a signal net (not a power or ground rail) that
+    another component drives from an output, bidirectional or tri-state pin.
+    A CS tied to a rail, or reached only through passives, is not driven.
+    """
+    cs_net = _get_pin_net(ctx, ref, _SPI_CS_NAMES)
+    if not cs_net or cs_net not in ctx.nets:
+        return None
+    if ctx.is_power_net(cs_net) or ctx.is_ground(cs_net):
+        return None
+    for p in ctx.nets[cs_net].get('pins', []):
+        other = p.get('component') or ''
+        if not other or other == ref or other.startswith('#'):
+            continue
+        if p.get('pin_type') in ('output', 'bidirectional', 'tri_state'):
+            return cs_net, f"{other}.{p.get('pin_name') or p.get('pin_number')}", other
+    return None
+
+
+# Candidate SPI tokens; I2C aliases/roles are excluded by _spi_peer.
+_SPI_CLOCK_TOKENS = frozenset(('SCK', 'SPC', 'CLK', 'SPICLK'))
+_SPI_DATA_TOKENS = frozenset(('MOSI', 'MISO', 'SDI', 'SDO', 'DIN', 'DOUT',
+                              'DI', 'DO', 'SI', 'SO', 'COPI', 'CIPO'))
+
+
+def _spi_peer(ctx: AnalysisContext, ref: str, clock_net: str,
+              data_net: str) -> tuple[str, str, str] | None:
+    """Clock/data pin pair on one peer without an I2C role on this bus.
+
+    Composite I2C/SPI aliases and I2C_CLK/I2C_DO names cannot prove SPI.
+    Generic tokens on unrelated components or on a single net cannot either.
+    """
+    if clock_net == data_net:
+        return None
+    for p in ctx.nets.get(clock_net, {}).get('pins', []):
+        other = p.get('component') or ''
+        if not other or other == ref or other.startswith('#'):
+            continue
+        bus_pins = [pin for net in (clock_net, data_net)
+                    for pin in ctx.nets.get(net, {}).get('pins', [])
+                    if pin.get('component') == other]
+        names = [set(re.split(r'[^A-Z0-9]+', (pin.get('pin_name') or '').upper()))
+                 for pin in bus_pins]
+        if any(any(t.startswith(('I2C', 'TWI')) or t in _I2C_SDA_NAMES + _I2C_SCL_NAMES
+                   for t in name) for name in names):
+            continue
+        component = next((c for c in ctx.components if c.get('reference') == other), {})
+        if match_ic_keywords(component, _I2C_IC_KEYWORDS):
+            continue
+        clock_name = set(re.split(r'[^A-Z0-9]+', (p.get('pin_name') or '').upper()))
+        if not clock_name & _SPI_CLOCK_TOKENS:
+            continue
+        for data in ctx.nets.get(data_net, {}).get('pins', []):
+            if data.get('component') != other:
+                continue
+            data_name = set(re.split(r'[^A-Z0-9]+', (data.get('pin_name') or '').upper()))
+            if data_name & _SPI_DATA_TOKENS:
+                return f"{other}.{p.get('pin_name')}", f"{other}.{data.get('pin_name')}", other
+    return None
+
+
+def _bus_mode(ctx: AnalysisContext, ref: str, sda_net: str, scl_net: str):
+    """Classify a dual-mode device's SDA/SCL pins from captured topology.
+
+    Returns (mode, cs_net, evidence, evidence_refs) with mode 'spi' or
+    'unresolved', or None (I2C). Pin names do not select the bus: SPI needs
+    positive evidence, a chip-select driven by another component AND
+    an SPI clock/data pair on one peer without an I2C role on distinct
+    clock (SCL) and data (SDA) nets. A driven chip-select without that
+    topology leaves the mode unresolved; the caller keeps the I2C requirement and says so.
+    """
+    driven = _driven_chip_select(ctx, ref)
+    if not driven:
+        return None
+    cs_net, driver, driver_ref = driven
+    peer = _spi_peer(ctx, ref, scl_net, sda_net) if cs_net not in (scl_net, sda_net) else None
+    if peer:
+        clock, data, peer_ref = peer
+        refs = sorted({driver_ref, peer_ref})
+        return ('spi', cs_net, f'chip-select {cs_net} driven by {driver}; '
+                f'SPI clock {clock}, SPI data {data}', refs)
+    return 'unresolved', cs_net, driver, [driver_ref]
+
