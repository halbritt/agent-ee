      "exit_code": 0,
      "stdout": "kicad-version.stdout",
      "stderr": "kicad-version.stderr"
    },
    {
      "name": "ngspice-version",
      "argv": [
        "ngspice",
        "--version"
      ],
      "cwd": "/work/experiments",
      "exit_code": 0,
      "stdout": "ngspice-version.stdout",
      "stderr": "ngspice-version.stderr"
    },
    {
      "name": "python-version",
      "argv": [
        "python3",
        "--version"
      ],
      "cwd": "/work/experiments",
      "exit_code": 0,
      "stdout": "python-version.stdout",
      "stderr": "python-version.stderr"
    },
    {
      "name": "netlist",
      "argv": [
        "kicad-cli",
        "sch",
        "export",
        "netlist",
        "--format",
        "kicadxml",
        "-o",
        "/work/experiments/native-export.xml",
