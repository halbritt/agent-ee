"wire_tool_inputs":{"toolu_016DZBtmRvjd8H1STJoEQR97":{"command":"cat > /work/experiments/shutdown_discharge.cir <<'EOF'\n* Shutdown discharge: C1=100n initially 1V on /OUT, /IN grounded at t=0, no load\n* Netlist per work/netlist/design.xml: R1 10k between /IN and /OUT, C1 100n /OUT-GND\n* /IN grounded => R1 from OUT to node 0\nR1 out 0 10k\nC1 out 0 100n IC=1\n.tran 1u 6m uic\n.control\nrun\nlet v5 = v(out)[5000]\nprint v5\nmeas tran vout5ms find v(out) at=5m\n.endc\n.end\nEOF\nngspice -b /work/experiments/shutdown_discharge.cir 2>&1 | tee /work/experiments/shutdown_discharge_output.txt; ngspice --version | head -3 >> /work/experiments/shutdown_discharge_output.txt\npython3 -c \"\nimport math\ntau=10e3*100e-9\nv=1*math.exp(-5e-3/tau)\nt_req=-tau*math.log(0.01)\nprint(f'tau = {tau*1e3:.3f} ms')\nprint(f'V(5ms) analytical = {v*1e3:.4f} mV (limit 10 mV) -> {\\\"PASS\\\" if v<=0.01 else \\\"FAIL\\\"}')\nprint(f'time to reach 10 mV = {t_req*1e3:.4f} ms (deadline 5 ms, margin {(5e-3-t_req)*1e3:.4f} ms = {(5e-3-t_req)/5e-3*100:.1f}% of window)')\n\" | tee /work/experiments/analytical_calc.txt","description":"Run ngspice RC discharge simulation and analytical calculation"}}}
