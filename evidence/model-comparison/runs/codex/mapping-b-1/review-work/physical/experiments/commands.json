{
  "entry_command": "/usr/bin/python3 /work/experiments/verify_physical.py > /work/experiments/verify-console.txt 2>&1",
  "environment_overrides": {
    "KICAD_CONFIG_HOME": "/work/experiments/kicad-config",
    "KICAD10_SYMBOL_DIR": "/candidate/stock/symbols",
    "KICAD10_FOOTPRINT_DIR": "/candidate/stock/footprints"
  },
  "commands": [
    {
      "argv": [
        "kicad-cli",
        "version"
      ],
      "cwd": "/work/experiments",
      "exit_code": 0,
      "log": "kicad-version.txt"
    },
    {
      "argv": [
        "kicad-cli",
        "pcb",
        "drc",
        "--format",
        "json",
        "--severity-all",
        "--schematic-parity",
        "--units",
        "mm",
        "-o",
        "/work/experiments/drc.json",
        "/candidate/project/rc_filter.kicad_pcb"
      ],
      "cwd": "/work/experiments",
      "exit_code": 0,
      "log": "drc-console.txt"
    },
    {
      "argv": [
        "kicad-cli",
        "sch",
        "erc",
        "--format",
        "json",
        "--severity-all",
        "--units",
        "mm",
        "-o",
        "/work/experiments/erc.json",
        "/candidate/project/rc_filter.kicad_sch"
      ],
      "cwd": "/work/experiments",
      "exit_code": 0,
      "log": "erc-console.txt"
    },
    {
      "argv": [
        "kicad-cli",
        "sch",
        "export",
        "netlist",
        "--format",
        "kicadxml",
        "-o",
        "/work/experiments/design.xml",
        "/candidate/project/rc_filter.kicad_sch"
      ],
      "cwd": "/work/experiments",
      "exit_code": 0,
      "log": "netlist-console.txt"
    }
  ]
}
