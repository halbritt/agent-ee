epted.\"}],\"run_id\":\"a04df47a-6c9b-4bcb-8846-55c997dadd7b\",\"schema\":\"agent-ee.decisions/1\",\"toolAction\":\"Completing adjudication with verified decision\",\"toolSummary\":\"Complete adjudication with decision\"}\n","duration_seconds":16.324010419,"usage":{"input_tokens":3179,"output_tokens":1142,"thinking_tokens":362,"cache_read_tokens":66582,"total_tokens":4321}}}
