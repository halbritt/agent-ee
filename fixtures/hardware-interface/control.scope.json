    },
    {
      "path": "requirements.md",
      "at": "requirements.md"
    },
    {
      "path": "contract.json",
      "at": "contract.json"
    },
    {
      "path": "interface.kicad_pcb",
      "at": "interface.kicad_pcb"
    }
  ],
  "schematic": "interface.kicad_sch",
  "requirements": [
