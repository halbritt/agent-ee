        "*.kicad_sym",
        "*.pretty/**",
        "*.lib",
        "*.dcm"
      ]
    },
    {
      "path": "/usr/share/kicad",
      "at": "stock",
      "include": [
        "template/sym-lib-table",
        "template/fp-lib-table",
