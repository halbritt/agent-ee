  "host_interval_template": {
    "assertions": [
      {
        "id": "i2c-rise",
        "lhs": ".8473*pullup_r*bus_c",
        "op": "<=",
        "requirement": "acq-jst-ph-i2c-i2c-bus-envelope",
        "rhs": "rise_limit",
        "unit": "s"
      },
      {
        "id": "i2c-sink",
        "lhs": "rail/pullup_r",
        "op": "<=",
        "requirement": "acq-jst-ph-i2c-i2c-bus-envelope",
        "rhs": "sink_limit",
        "unit": "A"
      },
      {
        "id": "i2c-high",
        "lhs": "rail_low-pullup_r*combined_leak-.7*rail_high",
        "op": ">=",
        "requirement": "acq-jst-ph-i2c-i2c-bus-envelope",
        "rhs": "zero_v",
        "unit": "V"
      },
      {
        "id": "i2c-low",
        "lhs": ".3*rail_low-sink_vol",
        "op": ">=",
        "requirement": "acq-jst-ph-i2c-i2c-bus-envelope",
        "rhs": "zero_v",
        "unit": "V"
      }
    ],
    "correlation": "shared-symbol/independent-parameters",
    "parameters": {
