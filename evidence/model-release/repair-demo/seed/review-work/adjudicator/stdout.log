            0\nvstep#branch                                 0\n\n\nNo. of Data Rows : 1025\n\n  Measurements for Transient Analysis\n\nvout_1ms            =  9.516251e-02\nvout_5ms            =  3.934693e-01\n\nbinary raw file \"/work/result.raw\"\nngspice-42 done\n{\n  \"candidate_id\": \"329f916010187406f161061477ccaa609a7cfa22231e8b51f90b321f35ab1028\",\n  \"details\": {\n    \"elements\": {\n      \"C1\": {\n        \"class\": \"C\",\n        \"nets\": [\n          \"/OUT\",\n          \"GND\"\n        ],\n        \"parsed\": 1.0000000000000001e-07,\n        \"sheet\": \"/\",\n        \"uuid\": \"1dcaf7b4-dc79-5865-a3a4-db0c3eaad5d8\",\n        \"value\": \"100n\"\n      },\n      \"R1\": {\n        \"class\": \"R\",\n        \"nets\": [\n          \"/IN\",\n          \"/OUT\"\n        ],\n        \"parsed\": 100000.0,\n        \"sheet\": \"/\",\n        \"uuid\": \"c5c38e1a-7593-5c99-b971-2f9d2e7bef78\",\n        \"value\": \"100k\"\n      }\n    },\n    \"excluded_dnp\": [],\n    \"ignored_components\": [\n      \"J1\"\n    ],\n    \"measurements\": {\n      \"vout_1ms\": {\n        \"at_ms\": 1.0,\n        \"max\": 0.65,\n        \"measured\": 0.09516251,\n        \"min\": 0.62,\n        \"within_limits\": false\n      },\n      \"vout_5ms\": {\n        \"at_ms\": 5.0,\n        \"max\": null,\n        \"measured\": 0.3934693,\n        \"min\": null\n      }\n    },\n    \"method\": \"ngspice -n -b -o <log> <control.sp>; -b -r is not used because it silently skips .meas\",\n    \"node_map\": {\n      \"/IN\": \"IN\",\n      \"/OUT\": \"OUT\",\n      \"GND\": \"0\"\n    },\n    \"raw\": {\n      \"points\": 1025,\n      \"variables\": [\n        \"time\",\n        \"v(in)\",\n        \"v(out)\",\n        \"i(vstep)\"\n      ]\n    },\n    \"tool\": {\n      \"argv\": [\n        \"ngspice\",\n        \"-n\",\n        \"-b\",\n        \"-o\",\n        \"/work/ngspice.log\",\n        \"/work/control.sp\"\n      ],\n      \"console_sha256\": \"2925646d2255478f43ed0