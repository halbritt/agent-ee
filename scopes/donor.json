  "schematic": "project/Polygonus-Universal-Base.kicad_sch",
  "board": "project/Polygonus-Universal-Base.kicad_pcb",
  "inputs": [
    {
      "path": "/home/halbritt/git/Polygonus-Universal-112",
      "at": "project",
      "include": [
        "*.kicad_sch",
        "*.kicad_pcb",
