+#!/usr/bin/env python3
+"""Unit tests for PP-001 source recognition and PR-001 bus classification.
+
+Covers two analyzer false-positive classes and their controls:
+
+* PP-001 (``audit_power_pin_dc_paths``) re-walks a pin that reaches no
+  named rail or connector under stated assumptions: another component's
+  ``power_out`` pin counts as a source once that component is itself
+  powered, and a P-MOSFET is crossed only when the netlist holds its gate
+  at ground with no competing pull-up. A pin cleared that way gets an info
+  finding that lists the assumptions; it is never silently cleared. A
+  competing gate pull-up, a driven gate, an unpowered power_out owner and
+  a capacitor-only supply keep the error, and unresolved P-MOSFET
+  conduction is named in it.
+* PR-001 (``validate_i2c_bus``) classifies a dual-mode I2C/SPI device as
+  SPI only on positive topology evidence: a chip-select driven by another
+  component AND SPI-only pin names of other components on both its clock
+  and data nets. A driven chip-select without that topology is reported as
+  unresolved and the missing-pull-up errors stay. A chip-select tied to a
+  rail stays on the I2C bus.
+
+Every netlist here is authored for this test. Run with:
+    python3 -m unittest skills/kicad/scripts/test_power_and_bus_classification.py
+"""
+
+import os
+import sys
+import unittest
+
+SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
+if SCRIPT_DIR not in sys.path:
+    sys.path.insert(0, SCRIPT_DIR)
+
+from kicad_types import AnalysisContext  # noqa: E402
+from signal_detectors import audit_power_pin_dc_paths  # noqa: E402
+from validation_detectors import validate_i2c_bus  # noqa: E402
+
+
+def context(parts):
+    """parts: [(ref, type, value, lib_id, [(number, name, pin_type, net)])]."""
+    components, nets, pin_net = [], {}, {}
+    for ref, kind, value, lib_id, pins in parts:
+        components.append({
+            "reference": ref, "type": kind, "value": value, "lib_id": lib_id,
+            "pins": [{"number": n, "name": name} for n, name, _t, _net in pins]})
+        for number, name, pin_type, net in pins:
+            nets.setdefault(net, {"name": net, "pins": []})["pins"].append({
+                "component": ref, "pin_number": number, "pin_name": name,
+                "pin_type": pin_type})
+            pin_net[(ref, number)] = (net, name)
+    return AnalysisContext(components=components, nets=nets, lib_symbols={},
+                           pin_net=pin_net)
+
+
+def cap(ref, a, b):
+    return (ref, "capacitor", "1uF", "Device:C",
+            [("1", "~", "passive", a), ("2", "~", "passive", b)])
+
+
+def res(ref, value, a, b):
+    return (ref, "resistor", value, "Device:R",
+            [("1", "~", "passive", a), ("2", "~", "passive", b)])
+
+
+def load(ref, net):
+    return (ref, "ic", "OwnedLoad", "Owned:Load",
+            [("1", "VIN", "power_in", net), ("2", "GND", "power_in", "GND")])
+
+
+def pmos(ref, gate, drain, source, lib_id="Owned:Q_PMOS"):
+    return (ref, "transistor", "OwnedFET", lib_id,
+            [("1", "G", "input", gate), ("2", "D", "passive", drain),
+             ("3", "S", "passive", source)])
+
+
+def mcu(ref, nets):
+    pins = [("1", "VDD", "power_in", "+3V3"), ("2", "GND", "power_in", "GND")]
+    pins += [(str(3 + i), f"IO{i}", "bidirectional", n) for i, n in enumerate(nets)]
+    return (ref, "ic", "OwnedMCU", "Owned:MCU", pins)
+
+
+def imu(ref, cs, scl, sda):
+    return (ref, "ic", "LSM6DSO32", "Owned:IMU",
+            [("1", "VDD", "power_in", "+3V3"), ("2", "GND", "power_in", "GND"),
+             ("3", "CS", "input", cs), ("4", "SCL", "input", scl),
+             ("5", "SDA", "bidirectional", sda)])
+
+
+def pp001(parts, severity):
+    return [f for f in audit_power_pin_dc_paths(context(parts))
+            if f["rule_id"] == "PP-001" and f["severity"] == severity]
+
+
+def pp001_refs(parts):
+    return sorted(f["components"][0] for f in pp001(parts, "error"))
+
+
+def adc(ref, cs, clk, din, dout):
+    return (ref, "ic", "OwnedADC", "Owned:ADC",
+            [("1", "VDD", "power_in", "+3V3"), ("2", "GND", "power_in", "GND"),
+             ("3", "CS", "input", cs), ("4", "CLK", "input", clk),
+             ("5", "Din", "input", din), ("6", "Dout", "output", dout)])
+
+
+class PowerPinSourceTests(unittest.TestCase):
+    def test_power_out_through_inductor_is_a_source(self):
+        parts = [
+            ("U1", "ic", "OwnedBuck", "Owned:Buck",
+             [("1", "VIN", "power_in", "+12V"), ("2", "SW", "power_out", "SW_NODE")]),
+            ("L1", "inductor", "15uH", "Device:L",
+             [("1", "1", "passive", "SW_NODE"), ("2", "2", "passive", "MID_NODE")]),
+            cap("C1", "MID_NODE", "GND"), load("U2", "MID_NODE")]
+        self.assertEqual(pp001_refs(parts), [])
+
+    def test_power_out_on_same_net_is_a_source(self):
+        parts = [
+            ("U3", "ic", "OwnedBuffer", "Owned:Buffer",
+             [("1", "OUT", "power_out", "REF_BUF"), ("2", "V+", "power_in", "+3V3")]),
+            cap("C2", "REF_BUF", "GND"), load("U4", "REF_BUF")]
+        self.assertEqual(pp001_refs(parts), [])
+
+    def test_power_out_clearance_is_an_info_assumption_not_silence(self):
+        parts = [
+            ("U3", "ic", "OwnedBuffer", "Owned:Buffer",
+             [("1", "OUT", "power_out", "REF_BUF"), ("2", "V+", "power_in", "+3V3")]),
+            cap("C2", "REF_BUF", "GND"), load("U4", "REF_BUF")]
+        info = pp001(parts, "info")
+        self.assertEqual([f["components"] for f in info], [["U4"]])
+        self.assertIn("U3.1 (OUT) is declared power_out", info[0]["assumptions"][0])
+
+    def test_unpowered_power_out_owner_is_not_a_source(self):
+        # The regulator's own input is only AC-coupled: its output proves nothing.
+        parts = [cap("C4", "+12V", "AC_IN"), cap("C5", "AC_IN", "GND"),
+                 ("U1", "ic", "OwnedReg", "Owned:Reg",
+                  [("1", "IN", "power_in", "AC_IN"), ("2", "OUT", "power_out", "REG_OUT"),
+                   ("3", "GND", "power_in", "GND")]),
+                 cap("C6", "REG_OUT", "GND"), load("U2", "REG_OUT")]
+        self.assertEqual(pp001_refs(parts), ["U1", "U2"])
+
+    def test_power_out_owner_without_supply_pin_is_not_a_source(self):
+        parts = [("U1", "ic", "OwnedDriver", "Owned:Driver",
+                  [("1", "OUT", "power_out", "DRV_NODE")]),
+                 cap("C6", "DRV_NODE", "GND"), load("U2", "DRV_NODE")]
+        self.assertEqual(pp001_refs(parts), ["U2"])
+
+    def test_power_out_loop_does_not_vouch_for_itself(self):
+        parts = [("U1", "ic", "OwnedReg", "Owned:Reg",
+                  [("1", "IN", "power_in", "NODE_B"), ("2", "OUT", "power_out", "NODE_A")]),
+                 ("U2", "ic", "OwnedReg", "Owned:Reg",
+                  [("1", "IN", "power_in", "NODE_A"), ("2", "OUT", "power_out", "NODE_B")]),
+                 cap("C1", "NODE_A", "GND"), cap("C2", "NODE_B", "GND")]
+        self.assertEqual(pp001_refs(parts), ["U1", "U2"])
+
+    def test_own_power_out_is_not_a_source(self):
+        parts = [("U4", "ic", "OwnedLoad", "Owned:Load",
+                  [("1", "VIN", "power_in", "LOOP_NODE"),
+                   ("2", "OUT", "power_out", "LOOP_NODE")]),
+                 cap("C2", "LOOP_NODE", "GND")]
+        self.assertEqual(pp001_refs(parts), ["U4"])
+
+    def test_control_capacitor_only_supply_is_still_reported(self):
+        parts = [cap("C4", "+12V", "AC_NODE"), cap("C5", "AC_NODE", "GND"),
+                 load("U8", "AC_NODE")]
+        self.assertEqual(pp001_refs(parts), ["U8"])
+
+
+class SwitchConductionTests(unittest.TestCase):
+    def protection(self, gate_parts, fet=None):
+        return ([("J1", "connector", "OwnedConn", "Owned:Conn",
+                  [("1", "Pin_1", "passive", "IN_RAW"), ("2", "Pin_2", "passive", "GND")]),
+                 fet or pmos("Q1", "GATE_NODE", "IN_RAW", "PROT_NODE"),
+                 cap("C3", "PROT_NODE", "GND"), load("U5", "PROT_NODE")] + gate_parts)
+
+    def test_pmos_with_gate_pulled_to_ground_conducts(self):
+        zener = ("D1", "diode", "OwnedZener", "Device:D_Zener",
+                 [("1", "K", "passive", "PROT_NODE"), ("2", "A", "passive", "GATE_NODE")])
+        parts = self.protection([res("R1", "100k", "GATE_NODE", "GND"), zener])
+        self.assertEqual(pp001_refs(parts), [])
+        (info,) = pp001(parts, "info")
+        self.assertEqual(info["components"], ["U5"])
+        self.assertIn("Q1 gate held at ground by R1", info["assumptions"][0])
+        self.assertIn("|VGS(th)|", info["assumptions"][0])
+        self.assertIn("clamp D1", info["assumptions"][0])
+
+    def test_diode_polarity_names_and_numeric_pin_function_metadata(self):
+        for names, metadata in ((('CATHODE', 'ANODE'), None),
+                                (('1', '2'), 'net'), (('~', '~'), 'net'),
+                                (('1', '2'), 'component')):
+            with self.subTest(names=names, metadata=metadata):
+                diode = ("D1", "diode", "OwnedZener", "Device:D_Zener",
+                         [("1", names[0], "passive", "PROT_NODE"),
+                          ("2", names[1], "passive", "GATE_NODE")])
+                ctx = context(self.protection([res("R1", "100k", "GATE_NODE", "GND"), diode]))
+                if metadata == 'component':
+                    for component in ctx.components:
+                        if component['reference'] == 'D1':
+                            for pin in component['pins']:
+                                pin['pin_function'] = ('CATHODE' if pin['number'] == '1' else 'ANODE')
+                if metadata == 'net':
+                    for net in ctx.nets.values():
+                        for pin in net['pins']:
+                            if pin['component'] == 'D1':
+                                pin['pin_function'] = ('Cathode' if pin['pin_number'] == '1'
+                                                       else 'Anode')
+                findings = audit_power_pin_dc_paths(ctx)
+                self.assertFalse([f for f in findings if f['severity'] == 'error'])
+                (info,) = [f for f in findings if f['rule_id'] == 'PP-001']
+                self.assertEqual(info['source_path'], 'assumed')
+                self.assertIn('clamp D1', info['assumptions'][0])
+
+    def test_ambiguous_or_reversed_diode_polarity_keeps_error(self):
+        for names in (('1', '2'), ('~', '~'), ('ANODE', 'CATHODE'), ('K', '~')):
+            with self.subTest(names=names):
